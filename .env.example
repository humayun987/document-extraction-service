# OpenAI-compatible LLM Gateway credentials (provided at runtime by evaluation harness)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Service configuration
SERVICE_PORT=8080
TARGET_ROLE=aiml
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/outcome_extraction
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE=52428800
MAX_DOCUMENT_PROCESSING_TIME=1800
EXPECTED_CONCURRENT_DOCUMENTS=10
WORKER_LEASE_SECONDS=60
WORKER_POLL_INTERVAL=1.0
